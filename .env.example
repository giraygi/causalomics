# Copy to .env and adjust. All values have development defaults in docker-compose.yml,
# so the application also starts without a .env file.

COMPOSE_PROJECT_NAME=causalomics

# Published ports on the host
FRONTEND_PORT=8080
BACKEND_PORT=8001

# PostgreSQL
POSTGRES_DB=causalomics
POSTGRES_USER=causalomics
POSTGRES_PASSWORD=change-me

# Login for the web UI / API (single user)
APP_USERNAME=admin
APP_PASSWORD=change-me
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_EXPIRE_MINUTES=120

# Importer
IMPORT_DATASET_NAME=example-dataset
